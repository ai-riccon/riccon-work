<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.riccon</groupId>
    <artifactId>riccon-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>riccon-api</artifactId>
  <name>riccon-api</name>
  <description>Riccon 同步 HTTP 服务：认证、RBAC、会话、业务 API 与审计入口</description>

  <properties>
    <!--
      S3 兼容对象存储客户端与 Worker 使用同一版本；仅本模块使用，不属于合同 stack.versions。
      升级时必须同步安全扫描与许可证检查（合同 constraints.licensing）。
    -->
    <aws-sdk.version>2.59.2</aws-sdk.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.riccon</groupId>
      <artifactId>riccon-platform-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.riccon</groupId>
      <artifactId>riccon-platform-domain</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!--
      M04 可观测性基线（ADR-0021 §10.6、TM-54、B-20）：引入 Prometheus registry，
      让 Micrometer 能把指标以 Prometheus 文本格式暴露。
      版本由 Spring Boot BOM（Micrometer 1.17.2）管理，不在此处 pin；
      `management.endpoints.web.exposure.include` 与 `/actuator/prometheus` 来源控制归 B2（TASK-0103），
      指标注册归 B4/B6/B7，本任务只提供依赖与抓取断言。
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!--
      M10 OIDC/SSO：Spring Boot 4.1 的 canonical OAuth2 Client starter（oauth2Login），
      复用既有 Spring Security 7 与 Nimbus JOSE，不引入第二套安全/HTTP 栈；见 ADR-0019。
      版本由 Boot BOM 管理，不单独声明。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
    </dependency>
    <!-- M02 使用 Spring JDBC（无 ORM），见 ADR-0009 与 ADR-0012。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- 会话存 MySQL，保证重启与多实例下登录态可恢复；见 ADR-0013。 -->
    <dependency>
      <groupId>org.springframework.session</groupId>
      <artifactId>spring-session-jdbc</artifactId>
    </dependency>
    <!-- Spring Boot 4 把 Session 自动配置拆成独立模块；缺少该依赖时 spring-session-jdbc 不会生效。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-session-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <!-- S3 协议客户端：上传原文、签发短期下载地址；对象 key 由 API 生成并带租户前缀。 -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${aws-sdk.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 集成测试使用真实 MySQL 8.4（Testcontainers），与测试栈版本一致；版本由 Boot BOM 管理。 -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- 保留普通 jar 供 ArchUnit 与应用间依赖使用；可执行包单独加 -exec 后缀。 -->
          <mainClass>com.riccon.api.ApiApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>banned-agentscope</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>io.agentscope:*</exclude>
                    <exclude>org.hibernate:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                  </excludes>
                  <message>apps/api 只允许 Spring JDBC；AgentScope 与 JPA/Hibernate 都不得进入同步 API。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <excludes>
                <!-- 启动类没有可测逻辑，不计入覆盖率。 -->
                <exclude>com/riccon/api/ApiApplication.class</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.line.minimum}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.branch.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
