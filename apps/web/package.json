{
  "name": "@riccon/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Riccon 员工端与管理端 Web（Umi Max + Ant Design 6 + Ant Design X 2）",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "max dev",
    "build": "max build",
    "setup": "max setup",
    "typecheck": "max setup && tsc --noEmit",
    "lint": "eslint --max-warnings=0 . && prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/pro-components": "3.1.15-9",
    "@ant-design/x": "2.10.0",
    "@ant-design/x-sdk": "2.10.0",
    "@umijs/max": "4.7.34",
    "antd": "6.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
