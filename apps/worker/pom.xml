<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.riccon</groupId>
    <artifactId>riccon-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>riccon-worker</artifactId>
  <name>riccon-worker</name>
  <description>Riccon 异步 Agent 运行与 MCP 代理：唯一允许依赖 agentscope 的部署物</description>

  <properties>
    <!--
      M02 Worker 新增的第三方库版本。仅本模块使用，不属于合同 stack.versions；
      升级时必须同步安全扫描与许可证检查（合同 constraints.licensing）。
    -->
    <pdfbox.version>3.0.8</pdfbox.version>
    <poi.version>5.5.1</poi.version>
    <aws-sdk.version>2.59.2</aws-sdk.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.riccon</groupId>
      <artifactId>riccon-platform-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.riccon</groupId>
      <artifactId>riccon-platform-domain</artifactId>
    </dependency>

    <!--
      M02 使用 Spring JDBC（无 ORM），见 ADR-0009 与 ADR-0012。
      Worker 只读取/推进运行、outbox、file_parse 与 knowledge_*，不执行 Flyway。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 文件解析：PDF 使用 PDFBox；DOCX/XLSX 使用 POI OOXML。均为 Apache-2.0。 -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
      <exclusions>
        <!-- 项目统一使用 spring-jcl 提供 commons-logging API，避免双绑定。 -->
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>

    <!-- S3 协议客户端：测试与私有化部署使用 S3 兼容对象存储（ADR-0002）。 -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${aws-sdk.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!--
      Boot 4 的 webmvc starter 不再默认带入 Jackson；Worker 需要解析 outbox payload
      与 OpenSearch JSON，因此显式引入 JSON starter。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!--
      M04 可观测性基线（ADR-0021 §10.6、TM-54、B-20）：Worker 承载路由/降级/key 场景，
      需要 Prometheus registry 才能被抓取；版本由 Spring Boot BOM（Micrometer 1.17.2）管理，
      不在此处 pin。7 个 riccon_* 指标的注册归 B4（TASK-0105），
      `/actuator/prometheus` 暴露与来源控制归 B2（TASK-0103）。
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!--
      只引入 agentscope-core，不引入 spring-boot starter：
      1) starter 自带 Spring Boot 4.0.1 的自动配置与依赖假设，会与根 BOM 的 4.1.2 产生版本解释偏差；
      2) worker 需要显式管理 Agent 生命周期与租户作用域，自动装配会在 M02 引入不可控的单例；
      3) core 已包含 Agent、模型与 MCP 客户端能力，足够 M01 冒烟与 M02 适配层使用。
      理由详见 docs/adr/ADR-0004-agentscope-core-not-starter.md。
    -->
    <dependency>
      <groupId>io.agentscope</groupId>
      <artifactId>agentscope-core</artifactId>
    </dependency>

    <!--
      仅测试作用域：agentscope-core 2.0.5 不包含 Docker 沙箱实现，官方沙箱位于同版本
      agentscope-harness（DockerSandbox）。这里只用于 M01 沙箱冒烟测试，不进入生产依赖，
      生产依赖仍遵循 ADR-0004 的“只引入 core”决策。
    -->
    <dependency>
      <groupId>io.agentscope</groupId>
      <artifactId>agentscope-harness</artifactId>
      <version>${agentscope.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Testcontainers 2.x（Boot 4.1 BOM 管理）：MySQL 与 S3 兼容存储使用真实容器，
      OpenSearch 使用 GenericContainer。MinIO 官方镜像已不可公开获取，按 ADR-0002
      使用 RustFS 容器验证同一套 S3 协议。
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mysql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.riccon.worker.WorkerApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>banned-worker-orm</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.hibernate:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                  </excludes>
                  <message>apps/worker 使用 Spring JDBC；JPA/Hibernate 不得进入 Worker。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <excludes>
                <exclude>com/riccon/worker/WorkerApplication.class</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.line.minimum}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.branch.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
