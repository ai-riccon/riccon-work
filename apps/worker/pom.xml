<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.riccon</groupId>
    <artifactId>riccon-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>riccon-worker</artifactId>
  <name>riccon-worker</name>
  <description>Riccon 异步 Agent 运行与 MCP 代理：唯一允许依赖 agentscope 的部署物</description>

  <dependencies>
    <dependency>
      <groupId>com.riccon</groupId>
      <artifactId>riccon-platform-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.riccon</groupId>
      <artifactId>riccon-platform-domain</artifactId>
    </dependency>

    <!--
      M02 的 Worker 需要读写运行状态、outbox 与审计，但持久化实现由 Builder 任务加入
      spring-boot-starter-jdbc 与 mysql-connector-j；本任务只固定共享领域词汇依赖，
      避免在 M02 业务代码尚未存在时改变 Worker 的启动/测试依赖面。
    -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!--
      只引入 agentscope-core，不引入 spring-boot starter：
      1) starter 自带 Spring Boot 4.0.1 的自动配置与依赖假设，会与根 BOM 的 4.1.2 产生版本解释偏差；
      2) worker 需要显式管理 Agent 生命周期与租户作用域，自动装配会在 M02 引入不可控的单例；
      3) core 已包含 Agent、模型与 MCP 客户端能力，足够 M01 冒烟与 M02 适配层使用。
      理由详见 docs/adr/ADR-0004-agentscope-core-not-starter.md。
    -->
    <dependency>
      <groupId>io.agentscope</groupId>
      <artifactId>agentscope-core</artifactId>
    </dependency>

    <!--
      仅测试作用域：agentscope-core 2.0.5 不包含 Docker 沙箱实现，官方沙箱位于同版本
      agentscope-harness（DockerSandbox）。这里只用于 M01 沙箱冒烟测试，不进入生产依赖，
      生产依赖仍遵循 ADR-0004 的“只引入 core”决策。
    -->
    <dependency>
      <groupId>io.agentscope</groupId>
      <artifactId>agentscope-harness</artifactId>
      <version>${agentscope.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.riccon.worker.WorkerApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>banned-worker-orm</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.hibernate:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                  </excludes>
                  <message>apps/worker 使用 Spring JDBC；JPA/Hibernate 不得进入 Worker。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <excludes>
                <exclude>com/riccon/worker/WorkerApplication.class</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.line.minimum}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.branch.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
