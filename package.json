{
  "name": "riccon-work",
  "version": "0.1.0",
  "private": true,
  "description": "Riccon 多租户 AI 协同办公系统：根 workspace 编排（前端与跨端验证）",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7.23.6": "7.29.13",
      "@babel/runtime@7.23.6": "7.29.14",
      "axios@0.27.2": "0.34.0",
      "immer@8.0.4": "9.0.6",
      "katex@0.16.47": "0.18.2",
      "node-fetch@1.7.3": "2.6.7",
      "path-to-regexp@1.7.0": "1.9.0",
      "path-to-regexp@8.2.0": "8.4.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-router@6.3.0": "6.30.4",
      "vite@7.3.6": "7.3.7"
    }
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,green,magenta \"pnpm run dev:api\" \"pnpm run dev:worker\" \"pnpm run dev:web\"",
    "dev:api": "./mvnw -q -pl apps/api spring-boot:run",
    "dev:worker": "./mvnw -q -pl apps/worker spring-boot:run",
    "dev:web": "pnpm --filter @riccon/web run dev",
    "build": "pnpm --filter @riccon/web run build",
    "lint": "pnpm --filter @riccon/web run lint",
    "typecheck": "pnpm --filter @riccon/web run typecheck",
    "test": "node apps/web/scripts/test.mjs",
    "test:affected": "node scripts/test-affected.mjs",
    "test-services": "node scripts/test-services.mjs",
    "test-services:up": "node scripts/test-services.mjs start",
    "test-services:down": "node scripts/test-services.mjs stop",
    "test-services:status": "node scripts/test-services.mjs status",
    "test-services:reset": "node scripts/test-services.mjs reset",
    "test-services:bench": "node scripts/test-services.mjs benchmark",
    "format": "pnpm --filter @riccon/web run format",
    "format:check": "pnpm --filter @riccon/web run format:check",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "a11y": "playwright test --config e2e/playwright.config.ts --grep @a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "concurrently": "10.0.7"
  }
}
